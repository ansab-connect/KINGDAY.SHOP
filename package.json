    "test": "vitest run"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@types/leaflet": "^1.9.12",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
