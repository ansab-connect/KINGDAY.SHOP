    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.161.0"
  },
  "engines": {
    "node": ">=20.9"
  }
