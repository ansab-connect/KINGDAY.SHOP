# ------------------------------------------------------------------
# KING DAY — environment variables
# Copy to .env.local for `next dev`. Never commit real values.
# On Cloudflare, set secrets with `npx wrangler secret put <NAME>`.
# ------------------------------------------------------------------

# Public site URL (used for metadata, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 4) — anon/publishable key is safe for the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — NEVER prefix with NEXT_PUBLIC_.
# Put it in .env.development.local (dev only), NOT .env.local: production builds
# bundle .env.local values. In production use: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay online payments. SERVER ONLY: never prefix these with NEXT_PUBLIC_.
# Use TEST keys (rzp_test_...) from Razorpay Dashboard > Account & Settings > API Keys (Test Mode).
# The key ID is sent to the browser per payment by the server; the secrets never are.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same secret you type when creating the webhook (URL: https://www.kingday.in/api/razorpay/webhook)
RAZORPAY_WEBHOOK_SECRET=
# Live keys (rzp_live_...) are refused unless this is "true". Leave unset until going live.
RAZORPAY_ALLOW_LIVE=

# Store contact
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Show clearly-labelled preview data in the admin panel until Supabase is connected
NEXT_PUBLIC_USE_PREVIEW_DATA=true

# Store contact details (rendered only when set)
NEXT_PUBLIC_STORE_EMAIL=
NEXT_PUBLIC_STORE_PHONE=
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

